# Provider connection (OpenRouter by default). Swap these three to change provider.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key_here
LLM_MODEL=openrouter/free

# 1 = return canned mock metadata with no model call; 0 = call the model
LLM_STUB=1

# Kill switch: false = always return the deterministic fallback, no model call
LLM_ENABLED=true

# 1 = skip deterministic shortcuts and always use the model (used by the eval)
DISABLE_DETERMINISTIC=0
